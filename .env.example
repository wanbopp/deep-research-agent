# ============================================================================
# DeepResearch 环境变量配置模板
# 复制为 .env.development 或 .env 使用
# cp .env.example .env.development
# ============================================================================

# ---- 应用配置 ----
APP_ENV=development
PROJECT_NAME=DeepResearch
VERSION=0.1.0
DEBUG=true
API_V1_STR=/api/v1

# ---- CORS ----
ALLOWED_ORIGINS=*

# ---- LLM 配置 ----
OPENAI_API_KEY=your-openai-api-key
# OpenAI-compatible provider 的完整 base URL；具体路径以服务商控制台文档为准
OPENAI_BASE_URL=
DEFAULT_LLM_MODEL=gpt-4o-mini
DEFAULT_LLM_TEMPERATURE=0.2
MAX_LLM_CALL_RETRIES=3
LLM_TOTAL_TIMEOUT=60
MAX_TOKENS=2000

# ---- Embedding 配置 ----
# 模型必须由当前 OpenAI-compatible provider 提供。维度是 pgvector 列类型的一部分，
# 修改 EMBEDDING_DIMENSIONS 前必须先编写迁移并重建已有向量。
EMBEDDING_MODEL=openai/text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
EMBEDDING_REQUEST_TIMEOUT=30
EMBEDDING_MAX_RETRIES=2

# ---- PostgreSQL ----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=deep_research_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
# 原生 psycopg pool：依赖探针，以及后续 LangGraph checkpointer。
POSTGRES_PSYCOPG_POOL_SIZE=5
# SQLAlchemy/SQLModel pool：业务 Repository 与事务。
POSTGRES_ORM_POOL_SIZE=5
POSTGRES_ORM_MAX_OVERFLOW=5

# ---- Neo4j 图数据库 ----
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j

# ---- Redis 缓存 ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
CACHE_TTL_SECONDS=60
# 长期记忆查询缓存使用短 TTL；用户级 generation 至少应覆盖该窗口。
MEMORY_SEARCH_CACHE_TTL_SECONDS=60
MEMORY_CACHE_GENERATION_TTL_SECONDS=86400

# ---- 后台会话增强 ----
# 自动命名租约必须长于 LLM_TOTAL_TIMEOUT，避免正常模型调用期间被其他 worker 接管。
CHAT_TITLE_CLAIM_LEASE_SECONDS=300
# 应用关闭时等待记忆与标题任务自然完成的预算；超时任务会被取消。
BACKGROUND_TASK_SHUTDOWN_TIMEOUT_SECONDS=15

# ---- 知识文档上传与索引 ----
# 开发环境使用本地 FileStorage；生产环境可替换为对象存储 adapter。
# 原始上传文档的本地存储根目录，支持相对路径和绝对路径。
KNOWLEDGE_STORAGE_ROOT=data/documents
# 单次上传允许的最大字节数，默认 10 MB。
KNOWLEDGE_MAX_UPLOAD_BYTES=10485760
# 读取上传文件时的流式分块大小（字节），默认 64 KB。
KNOWLEDGE_UPLOAD_READ_CHUNK_BYTES=65536
# 允许上传的 MIME 类型白名单，逗号分隔；不在列表中的类型将被拒绝。
KNOWLEDGE_ALLOWED_CONTENT_TYPES=application/pdf,text/markdown,text/plain,application/vnd.openxmlformats-officedocument.wordprocessingml.document
# 索引任务的最大重试次数，超过后标记为最终失败。
KNOWLEDGE_INDEX_MAX_ATTEMPTS=3
# 索引租约的有效期（秒），超时未完成的租约将被释放并允许其他 worker 接管。
KNOWLEDGE_INDEX_LEASE_SECONDS=300

# ---- JWT 认证 ----
# 必须为每个环境生成独立的 32 字节以上随机值；真实值只放在本地/部署 secret 中。
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# ---- 限流 ----
# 认证入口按服务端观察到的客户端 IP 计数。
AUTH_RATE_LIMIT_REQUESTS=20
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
# 高成本 Chat/Agent 入口按验签并经数据库确认的 user_id 计数。
AGENT_RATE_LIMIT_REQUESTS=20
AGENT_RATE_LIMIT_WINDOW_SECONDS=60
# 旧 SlowAPI 示例配置暂时保留，新代码不再解析该自由格式值。
RATE_LIMIT_DEFAULT=200 per day,50 per hour

# ---- 日志 ----
LOG_LEVEL=DEBUG
LOG_FORMAT=console
LOG_DIR=logs

# ---- Langfuse 可观测性 ----
LANGFUSE_TRACING_ENABLED=false
LANGFUSE_PUBLIC_KEY=your-langfuse-public-key
LANGFUSE_SECRET_KEY=your-langfuse-secret-key
LANGFUSE_HOST=https://cloud.langfuse.com
